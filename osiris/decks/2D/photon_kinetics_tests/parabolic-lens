! --- Simulation Configuration ---
simulation {
  n0 = 1.0,
  algorithm = "pkt",
}

! --- Node Configuration ---
node_conf {
  node_number(1:2) = 1, 1,
  if_periodic(1:2) = .false., .false.,
}

! --- Grid/Time Step Configuration ---
grid {
  nx_p(1:2) = 4000, 400,
  coordinates = "cartesian",
}

time_step {
  dt = 0.025,
  ndump = 100,
}

! --- Total Space/Time Configuration ---
! Static box (if_move=.false.) -- covers launch -> lens -> true focus (~276.7)
! -> ~60 units of post-focus margin.
space {
  xmin(1:2) = 50.0, -20.0,
  xmax(1:2) = 340.0, 20.0,
  if_move(1:2) = .false., .false.,
}

time {
  tmin = 0.0d0,
  tmax = 300.0,
}

! --- EMF Boundary Configuration ---
emf_bound {
  type(1:2,1:2) = "open","open", "open","open",
}

diag_emf {
  ndump_fac = 1,
  prec = 4,
  ndump_fac_ene_int = 1,
  reports = "e1","e2","e3","b1","b2","b3","ene_e2","ene_b"
}

! --- Particle Configuration ---
particles {
  num_species = 0,
  num_pkt = 1,
  interpolation = "quadratic",
}

! -------------------------------------------
! --- ELECTRONS/BACKGROUND PLASMA PROFILE ---
! -------------------------------------------
species {
  name = "plasma",
  num_par_max = 1650000,
  num_par_x(1:2) = 4, 4,
  rqm = -1.0,
  push_type = "standard",          ! feedback OFF -- isolates pure refraction
}

udist {
  use_classical_uadd = .true.,
  uth(1:3) = 0.0d0, 0.0d0, 0.0d0,
  ufl(1:3) = 0.0d0, 0.0d0, 0.0d0,
}

profile {
  profile_type = "channel",
  density = 1.0,
  channel_dir = 1,
  channel_r0 = 3.0,                ! w_ch
  channel_depth = 0.5,          ! beta -- designed for L=10, f=200
  channel_center = 0.0,
  channel_size = 28.0,
  channel_wall = 0.0,
  channel_pos(1:2) = 70.0, 72.5,   ! L = 10 (thicker, was 5)
  channel_bottom = 1.0,
}

spe_bound {
  type(1:2,1:2) = "open","open", "open","open",
}

diag_species {
  ndump_fac = 1,
  ndump_fac_ene = 1,
  ndump_fac_raw = 1,
  reports = "charge","ene",
}

! ----------------------
! --- PHOTON PROFILE ---
! ----------------------
species {
  name = "photons",
  num_par_max = 500000,
  num_par_x(1:2) = 4, 4,
  add_tag = .true.,
}

udist {
  use_classical_uadd = .true.,
  ufl(1:2) = 6.928, 0.0,
  uth(1) = 0.15,
  uth(2) = 0.0,                    ! collimated -- required for the analytic prediction
  uth(3) = 0.0,
}

profile {
  density = 0.32,
  profile_type(1:2) = "gaussian", "gaussian",
  gauss_center(1:2) = 60.0, 0.0,
  gauss_sigma(1:2) = 2.030, 1.5,
  gauss_range(1:2,1) = 50.0, 66.0,
  gauss_range(1:2,2) = -7.5, 7.5,
}

spe_bound {
  type(1:2,1:2) = "open","open", "open","open",
}

diag_species {
  ndump_fac = 1,
  ndump_fac_raw = 1,
  reports = "charge","ene",
}
