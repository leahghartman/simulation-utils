! --- Simulation Configuration ---
simulation {
  n0 = 3.6e19,
  algorithm = "pkt",
}

! --- Node Configuration ---
node_conf {
  node_number(1:2) = 1, 1,
  if_periodic(1:2) = .false., .false.,
}

! --- Grid/Time Step Configuration ---
grid {
  nx_p(1:2) = 640, 400,
  coordinates = "cartesian",
}
time_step {
  dt = 0.05,
  ndump = 100,
}

! --- Total Space/Time Configuration ---
space {
  xmin(1:2) = 30.0, -20.0,    ! was 50.0, -20.0
  xmax(1:2) = 130.0, 20.0,
  if_move(1:2) = .true., .false.,
}
time {
  tmin = 0.0d0,
  tmax = 5000.0,
}

! --- EMF Boundary Configuration ---
emf_bound {
  type(1:2,1:2) = "open","open", "open","open",
}
diag_emf {
  ndump_fac = 1,
  prec = 4,
  ndump_fac_ene_int = 1,
  reports = "e1","e2","e3","b1","b2","b3","ene_e2","ene_b"
}

! --- Particle Configuration ---
particles {
  num_species = 0,
  num_pkt = 1,
  interpolation = "quadratic",
}

! -------------------------------------------
! --- ELECTRONS/BACKGROUND PLASMA PROFILE ---
! -------------------------------------------
species {
  name = "plasma",
  num_par_max = 500000,
  num_par_x(1:2) = 4, 4,
  rqm = -1.0,
  push_type = "std_photon_feedback",
}
udist {
  use_classical_uadd = .true.,
  uth(1:3) = 0.0d0, 0.0d0, 0.0d0,
  ufl(1:3) = 0.0d0, 0.0d0, 0.0d0,
}
profile {
  profile_type(1:2) = "piecewise-linear", "piecewise-linear",
  num_x = 4,
  x(1:4,1)  = 30.0, 60.0, 65.0, 10000.0,
  fx(1:4,1) = 0.0,  0.0,  1.0,  1.0,
  x(1:4,2)  = -20.0, -10.0, 10.0, 20.0,
  fx(1:4,2) = 1.0, 1.0, 1.0, 1.0,
}
spe_bound {
  type(1:2,1:2) = "open","open", "open","open",
}
diag_species {
  ndump_fac = 1,
  ndump_fac_pha = 1,
  ndump_fac_ene = 1,
  ps_xmin(1:2) = -30.0, -20.0,
  ps_xmax(1:2) = 0.5, 20.0,
  ps_nx(1:2) = 500, 400,
  ps_pmin(1:3) = -1.5e0, -1.e-5, -1.e-5,
  ps_pmax(1:3) = 1.5e0, 1.e-5, 1.e-5,
  ps_np(1:3) = 200, 100, 100,
  reports = "charge","ene",
}

! ----------------------
! --- PHOTON PROFILE ---
! ----------------------
species {
  name = "photons",
  num_par_max = 500000,
  num_par_x(1:2) = 4, 4,
  add_tag = .true.,
}
udist {
  use_classical_uadd = .true.,
  ufl(1:2) = 6.928, 0.0,
  uth(1) = 0.246,                  ! unchanged from your validated 1D value
  uth(2) = 0.333,                  ! diffraction-limited: 1/w0, w0 = 3.0
  uth(3) = 0.0,
}
profile {
  density = 0.32,
  profile_type(1:2) = "gaussian", "gaussian",
  gauss_center(1:2) = 45.0, 0.0,
  gauss_sigma(1:2) = 2.030, 1.5,
  gauss_range(1:2,1) = 36.88, 53.12,
  gauss_range(1:2,2) = -10.0, 10.0,
}
spe_bound {
  type(1:2,1:2) = "open","open", "open","open",
}
diag_species {
  ndump_fac = 1,
  ndump_fac_raw = 1,
  reports = "charge","ene",
}
